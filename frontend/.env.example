# ── ShareXWave frontend env ──
# Backend API + Socket.IO base URL (no trailing slash)
VITE_API_URL=https://sharexwave-backend.onrender.com

# ── WebRTC TURN (optional but STRONGLY recommended) ──
# STUN alone only works when both peers are on friendly networks. For calls to
# connect across mobile data / strict (symmetric) NATs you need a TURN server.
# Leave these blank to use STUN only. Comma-separate multiple TURN URLs.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
