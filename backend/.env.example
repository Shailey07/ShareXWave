# ─── MongoDB Atlas ───
# Get this from Atlas → Connect → Drivers. Keep the password OUT of source control.
# Remove any angle brackets around the username/password when you paste your real values.
MONGODB_URI=
MONGODB_DB=

# ─── JWT ───
JWT_SECRET=

# ─── Admin panel (optional) ───
# ADMIN_PASSWORD_HASH is a bcrypt hash of the admin password (not the plain password).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ─── Server ───
PORT=5004
NODE_ENV=development
